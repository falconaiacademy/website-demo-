# Leave DATABASE_URL empty in local dev: an embedded Postgres (PGlite) is used,
# stored in ./.pglite-data. In production set a real Postgres URL.
DATABASE_URL=

# Basic-auth credentials for /admin (required in production)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Email notification on each new registration (any SMTP relay).
# If SMTP_HOST is empty, the email is just logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FalconAI Academy <no-reply@example.com>"
NOTIFY_TO=you@example.com

SITE_NAME="FalconAI Academy"
